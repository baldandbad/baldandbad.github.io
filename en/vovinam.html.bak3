<script>
  document.addEventListener('DOMContentLoaded', () => {
    const resultsDiv = document.getElementById('results');
    const searchInput = document.getElementById('searchInput');
    const categoryFilter = document.getElementById('categoryFilter');

    let pages = [];

    async function loadData() {
      try {
        const res = await fetch('js/pagesdata.json');
        if (!res.ok) throw new Error('Network response was not ok');
        pages = await res.json();
        displayResults(pages); // show all initially
      } catch (err) {
        console.error('Error loading pagesdata.json:', err);
        if (resultsDiv) resultsDiv.innerHTML = '<p>Error loading search data.</p>';
      }
    }

    function filterResults() {
      if (!pages || !Array.isArray(pages)) {
        displayResults([]);
        return;
      }
      const query = (searchInput && searchInput.value || '').toLowerCase().trim();
      const selectedCategory = (categoryFilter && categoryFilter.value) || 'all';

      const filtered = pages.filter(page => {
        const matchesCategory = selectedCategory === 'all' ||
          (Array.isArray(page.categories) && page.categories.includes(selectedCategory));
        const title = (page.title || '').toString().toLowerCase();
        const matchesQuery = title.includes(query);
        return matchesCategory && matchesQuery;
      });

      displayResults(filtered);
    }

    function displayResults(items) {
      if (!resultsDiv) return;
      if (!items || items.length === 0) {
        resultsDiv.innerHTML = '<p>No results found.</p>';
        return;
      }

      const html = items.map(item => {
        const url = (item.url || '#');
        // ensure categories is an array, not undefined
        const cats = Array.isArray(item.categories) ? item.categories.join(', ') : '';
        // if urls in your JSON are relative without leading slash, you can adjust here
        const href = url.startsWith('/') ? url : `/${url}`;
        const safeTitle = item.title ? escapeHtml(item.title) : '(no title)';
        return `
          <div class="result-item">
            <a href="${href}">${safeTitle}</a>
            <em style="display:block; font-size:0.9em;">(${escapeHtml(cats)})</em>
          </div>
        `;
      }).join('');

      resultsDiv.innerHTML = html;
    }

    // small helper to avoid inserting unexpected HTML from data
    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Attach event listeners (debounce optional)
    if (searchInput) searchInput.addEventListener('input', filterResults);
    if (categoryFilter) categoryFilter.addEventListener('change', filterResults);

    // initial load
    loadData();
  });
</script>

<button id="chatbox-toggle">TRỢ LÝ AI</button>
<div aria-hidden="true" id="chatbox-container">
<div id="chatbox-header"> Trợ lý AI <button id="chatbox-close">✖</button>
</div>
<div aria-live="polite" id="chatbox-messages">
<!-- sample messages -->
<div class="chat-message chat-ai">Xin chào!</div>
</div>

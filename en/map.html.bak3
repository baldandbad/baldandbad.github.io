// helper: map category -> CSS class
function categoryClass(cat){
  return {
    thanhpho: 'marker-cat-thanhpho',
    quocgia:  'marker-cat-quocgia',
    kientruc: 'marker-cat-kientruc',
    baotang:  'marker-cat-baotang',
    khaoco:   'marker-cat-khaoco',
    dacbiet:  'marker-cat-dacbiet',
    khu:      'marker-cat-kientruc',
    phivat:  'marker-cat-phivat'
  }[cat] || 'marker-cat-default';
}


// helper: safe slug for thumbnail filename if you have thumbs (optional)
function slugify(s){ return String(s||'').toLowerCase().replace(/[^\w]+/g,'-'); }

// Keep reference to currently active marker
let activeMarker = null;

function setActiveMarker(m) {
  // remove previous
  if (activeMarker && activeMarker.getElement) {
    const prev = activeMarker.getElement();
    if (prev) prev.classList.remove('marker-active');
  }
  activeMarker = m;
  if (!m) return;
  const el = m.getElement();
  if (el) el.classList.add('marker-active');
  // bring to front visually
  if (m._icon) m._icon.style.zIndex = 1000;
}


/* ---------- Enhanced markers + rich popup + legend ---------- */

// Category -> CSS color mapping (matches your existing CSS)

// helper: build popup HTML for a marker item
function buildPopupHtml(item) {
  const thumbUrl = item.image ? item.image : `images/thumbs/${slugify(item.name)}.jpg`;
  const snippet = item.snippet ? escapeHtml(item.snippet) : '';
  const alt = escapeHtml(item.name) + ' thumbnail';
  const cat = item.category || 'default';
  const borderColor = CATEGORY_COLORS[cat] || CATEGORY_COLORS.default || '#9ca3af';

  const decoPath = 'images/badges/kientruc.png'; // change path if needed

  // Build actions dynamically so we can conditionally omit the "Chỉ đường" button
  const buttons = [];

  // "Xem thêm" always shown (escape URL)
  buttons.push(
    `<a class="popup-btn primary" href="${escapeHtml(item.page)}" target="_blank" rel="noopener noreferrer">Xem thêm</a>`
  );

  // Only add "Chỉ đường" if category is NOT "phivat" (case-insensitive)
  const isPhiVat = item.category && String(item.category).toLowerCase() === 'phivat';
  if (!isPhiVat && item.coords && item.coords.length >= 2) {
    const lat = encodeURIComponent(item.coords[0]);
    const lng = encodeURIComponent(item.coords[1]);
    buttons.push(
      `<a class="popup-btn" href="https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}" target="_blank" rel="noopener noreferrer">Chỉ đường (Google maps)</a>`
    );
  }

  // VR button if present
  if (item.vr && item.vr !== 'non') {
    buttons.push(
      `<a class="popup-btn" href="${escapeHtml(item.vr)}" target="_blank" rel="noopener noreferrer">VR360</a>`
    );
  }

  const actions = `<div class="popup-actions-inline">${buttons.join('')}</div>`;

  const humanCategory = LEGEND_LABELS[item.category] || LEGEND_LABELS.default || (item.category || 'Khác');

  // include --deco inline so the pseudo-element can pick it up
  let vrSourceHtml = '';
  if (item.vr && item.vr !== 'non') {
    try {
      const urlObj = new URL(item.vr, window.location.origin);
      vrSourceHtml = `<div style="margin-top:8px;font-size:0.97em;color:#666;">Nguồn VR: ${urlObj.hostname.replace(/^www\./, '')}</div>`;
    } catch (e) {
      // fallback if URL parsing fails
      vrSourceHtml = `<div style="margin-top:8px;font-size:0.97em;color:#666;">Nguồn VR: ${item.vr}</div>`;
    }
  }

  return `
    <div class="custom-popup" style="--cat: ${borderColor}; --deco: url('${decoPath}')">
      <div class="popup-thumb-outer" aria-hidden="true">
        <div class="popup-thumb-inner">
          <img class="popup-thumb" src="${thumbUrl}" alt="${alt}" onerror="this.style.display='none'" />
        </div>
      </div>

      <h3>${escapeHtml(item.name)}</h3>
      ${ snippet ? `<p class="snippet">${snippet}</p>` : '' }
      <p class="meta">Loại: ${escapeHtml(humanCategory)}</p>
      ${actions}
      ${vrSourceHtml}
    </div>`;
}

// Build the divIcon HTML (keeps your styles)
function createDivIconHtml(item) {
  const cls = categoryClass(item.category);
  return `<div class="marker-inner ${cls}" aria-hidden="true"></div>`;
}

// robust svgDataIcon that doesn't fetch external files
function svgDataIcon(category, opts = {}) {
  const size = Number(opts.size) || 26;
  const color = (CATEGORY_COLORS && CATEGORY_COLORS[category]) ? CATEGORY_COLORS[category] : (CATEGORY_COLORS && CATEGORY_COLORS.default) || '#6b7280';
  // optional small white inner dot radius
  const outerR = (size/2) - 1;
  const innerR = Math.round(outerR * 0.46);

  // build simple pin-like circle SVG (you can replace with any SVG markup)
  const svg = `
    <svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
      <defs>
        <filter id="s" x="-50%" y="-50%" width="200%" height="200%">
          <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#000" flood-opacity="0.18"/>
        </filter>
      </defs>
      <g filter="url(#s)">
        <circle cx="${size/2}" cy="${size/2}" r="${outerR}" fill="${color}" stroke="#fff" stroke-width="2"/>
        <circle cx="${size/2}" cy="${size/2}" r="${innerR}" fill="#ffffff" opacity="0.18"/>
      </g>
    </svg>
  `.trim();

  const url = `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;

  return L.icon({
    iconUrl: url,
    iconSize: [size, size],
    iconAnchor: [size/2, size/2],
    popupAnchor: [0, -Math.round(size/2) - 6],
    className: ''
  });
}


// Create markers array (replaces your previous markerObjects block)
// call these once before creating markers
(async function initIconsAndMarkers() {
  await buildIconsFromExternalSvg();   // builds categoryIcons
  injectPopupCategoryCSS_Robust();           // add CSS for popups

  // Now create markers (example adapted from your code)
  window.markerObjects = data.map(item => {
    const ICON_SIZE = 18;
    const cat = item.category || 'default';
    const iconForCat = categoryIcons[cat] || categoryIcons.default || L.icon({ iconUrl: 'images/map-pin.svg', iconSize:[22,22], iconAnchor:[11,11] });

    const marker = L.marker(item.coords, { icon: iconForCat });

    // Build popup HTML via your buildPopupHtml() function
    const popupHtml = buildPopupHtml(item);

    // IMPORTANT: give the popup a category class (Leaflet puts this on .leaflet-popup-content-wrapper)
marker.bindPopup(buildPopupHtml(item), {
  minWidth: 260,
  maxWidth: 420,
  offset: L.point(0, -ICON_SIZE/2 - 6),
  autoPan: true,
  keepInView: true,
  className: 'popup-' + cat   // <-- this attaches .popup-<cat> to the wrapper
});


    // Tooltip etc (same as before)
    marker.bindTooltip(item.name, { permanent: false, direction: 'top', className: 'my-tooltip', offset: [0, -ICON_SIZE/2 - 8] });
    marker.category = item.category;
    marker.name = item.name;
    marker._page = item.page;

    marker.on('click', () => {
      if (typeof setActiveMarker === 'function') setActiveMarker(marker);
      marker.openPopup();
    });
    if (window.matchMedia && window.matchMedia('(pointer: fine)').matches) {
      marker.on('mouseover', () => marker.openTooltip());
      marker.on('mouseout',  () => marker.closeTooltip());
    }
    marker.on('add', () => {
      const el = marker.getElement();
      if (!el) return;
      el.setAttribute('tabindex','0');
      el.setAttribute('role','button');
      el.setAttribute('aria-label', item.name);
      el.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); marker.fire('click'); }
      });
    });

    markerCluster.addLayer(marker);
    return marker;
  });

  // expose for debugging
  window.categoryIcons = categoryIcons;
})();
// confirm icons created
console.log('categoryIcons keys:', Object.keys(window.categoryIcons || {}));
console.log('example icon options:', window.categoryIcons?.thanhpho?.options);

// check a marker just added
console.log('marker count in cluster:', markerCluster.getLayers().length);


// OPTIONAL: if you were doing a batched fade-in, you can replace the immediate adds with addMarkersWithFade(markerObjects, markerCluster);

// ---------- Build a legend and add to map (simple DOM inside map container) ----------
// Put this near your CATEGORY_COLORS definition

// Optional: specify exact order you want the legend items shown in.
// If you don't need a special order, set this to null or omit it.
const LEGEND_ORDER = [
  'dacbiet',
  'quocgia',
  'thanhpho',
  'kientruc',
  'baotang',
  'khaoco',
  'khu',
  'phivat',
  'default'
];

// Build legend using the custom labels and order
(function buildLegend(){
  const existing = document.getElementById('map-legend');
  if (existing) existing.remove();

  const legend = document.createElement('div');
  legend.id = 'map-legend';
  legend.setAttribute('aria-hidden','false');
  legend.style.position = 'absolute';
  legend.style.left = '12px';
  legend.style.bottom = '12px';
  legend.style.zIndex = 14000;
  legend.style.background = '#fff';
  legend.style.padding = '8px 10px';
  legend.style.borderRadius = '8px';
  legend.style.boxShadow = '0 18px 50px rgba(0,0,0,0.12)';
  legend.style.fontSize = '13px';

  const title = document.createElement('div');
  title.style.fontWeight = '700';
  title.style.marginBottom = '6px';
  title.innerText = 'Chú giải';
  legend.appendChild(title);

  // decide which categories to iterate (either custom order or keys from CATEGORY_COLORS)
  const keys = Array.isArray(LEGEND_ORDER) && LEGEND_ORDER.length
    ? LEGEND_ORDER.filter(k => CATEGORY_COLORS[k] !== undefined) // keep only known keys
    : Object.keys(CATEGORY_COLORS);

  keys.forEach(k => {
    const color = CATEGORY_COLORS[k] || CATEGORY_COLORS.default;
    const label = LEGEND_LABELS[k] || (k === 'default' ? 'Khác' : k);

    const item = document.createElement('div');
    item.className = 'legend-item';
    item.style.display = 'flex';
    item.style.alignItems = 'center';
    item.style.gap = '8px';
    item.style.margin = '6px 0';
    item.style.cursor = 'default';

    const dot = document.createElement('div');
    dot.className = 'legend-dot';
    dot.style.width = '12px';
    dot.style.height = '12px';
    dot.style.borderRadius = '50%';
    dot.style.background = color;
    dot.style.border = '2px solid #fff';
    dot.style.boxShadow = '0 2px 6px rgba(0,0,0,0.12)';

    const txt = document.createElement('div');
    txt.textContent = label;

    item.appendChild(dot);
    item.appendChild(txt);
    legend.appendChild(item);
  });

  document.getElementById('map').appendChild(legend);
})();



  /* ----------------- Street View (no API key) — embed with fallback ----------------- */
  /* This code uses public Google Maps URLs (no API key). It will try to embed in a modal iframe.
     If Google blocks embedding, we fall back to opening the URL in a new tab. */

  /* create modal once */
  (function(){
    if (document.getElementById('sv-modal')) return;
    const style = document.createElement('style');
    style.textContent = `
      #sv-modal { position:fixed; inset:0; display:none; align-items:center; justify-content:center; z-index:14000; }
      #sv-modal .sv-backdrop { position:absolute; inset:0; background:rgba(0,0,0,0.6); }
      #sv-modal .sv-panel { position:relative; width:min(1100px,94vw); height:min(720px,86vh); background:#fff; border-radius:10px; overflow:hidden; box-shadow:0 30px 80px rgba(0,0,0,.5); display:flex; flex-direction:column; }
      #sv-modal .sv-header { display:flex; justify-content:space-between; align-items:center; padding:8px 12px; background:#0b1220; color:#fff; font-weight:700; }
      #sv-modal .sv-body { flex:1; background:#000; display:flex; }
      #sv-modal iframe { width:100%; height:100%; border:0; display:block; }
      #sv-modal .sv-close { background:transparent; color:#fff; border:0; font-size:20px; cursor:pointer; padding:6px 10px; }
      #sv-modal .sv-fallback { padding:10px; text-align:center; font-size:13px; }
      .popup-btn.sv { background: #2563eb; } /* small visual tweak for the sv button */
    `;
    document.head.appendChild(style);

    const modal = document.createElement('div');
    modal.id = 'sv-modal';
    modal.innerHTML = `
      <div class="sv-backdrop" tabindex="-1"></div>
      <div class="sv-panel" role="dialog" aria-modal="true" aria-label="Street View">
        <div class="sv-header">
          <div class="sv-title">Xem 360</div>
          <div>
            <button class="sv-close" title="Đóng">✕</button>
          </div>
        </div>
        <div class="sv-body">
          <iframe sandbox="allow-scripts allow-same-origin allow-popups" src="about:blank" referrerpolicy="no-referrer"></iframe>
        </div>
        <div class="sv-fallback" style="display:none">
          Xem 360 không thể nhúng ở đây — <a class="sv-open-new" target="_blank" rel="noopener">Mở ở tab mới</a>
        </div>
      </div>
    `;
    document.body.appendChild(modal);
    const backdrop = modal.querySelector('.sv-backdrop');
    const closeBtn = modal.querySelector('.sv-close');
    const iframe = modal.querySelector('iframe');
    const fallback = modal.querySelector('.sv-fallback');
    const openNewLink = modal.querySelector('.sv-open-new');

    function closeModal(){
      iframe.src = 'about:blank';
      fallback.style.display = 'none';
      modal.style.display = 'none';
    }
    function openModalWithUrl(url){
      // try to embed
      modal.style.display = 'flex';
      iframe.src = url + '&output=embed';
      // set fallback link
      openNewLink.href = url;
      // after a short delay check if the iframe rendered a Google page or got blocked.
      // There is no reliable cross-origin check; do a pragmatic fallback: after 900ms if iframe
      // still has about:blank (rare) or user agent prevents rendering, show fallback.
      setTimeout(() => {
        // if iframe still 'about:blank' or has obvious block, show fallback — user can open new tab
        if (!iframe.src || iframe.src.indexOf('about:blank') !== -1) {
          fallback.style.display = 'block';
        } else {
          // sometimes Google will display a page that visually says "Sorry — we can't show" — user can close and open new tab
          fallback.style.display = 'none';
        }
      }, 900);
    }

    backdrop.addEventListener('click', closeModal);
    closeBtn.addEventListener('click', closeModal);
    // escape key
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.style.display === 'flex') closeModal(); });
    // expose helper
    window._openStreetViewModal = (lat, lng) => {
      // build a friendly Google Maps URL that opens at the nearest Street View pano:
      // use `layer=c&cbll=lat,lng&cbp=11,0,0,0,0`
      // also provide non-embed variant (without &output=embed) as fallback open-in-new
      const base = `https://www.google.com/maps?q=&layer=c&cbll=${encodeURIComponent(lat + ',' + lng)}&cbp=11,0,0,0,0`;
      try {
        openModalWithUrl(base);
      } catch (err) {
        // fallback: just open new tab
        window.open(base, '_blank', 'noopener');
      }
    };
  })();

// map category -> 
// decoration image (PNG or SVG). Put files in images/deco/
const CATEGORY_DECOS = {
  thanhpho:  'images/deco/thanhpho.png',
  quocgia:   'images/deco/quocgia.png',
  kientruc:  'images/deco/kientruc.png',
  baotang:   'images/deco/baotang.png',
  khaoco:    'images/deco/khaoco.png',
  dacbiet:   'images/deco/dacbiet.png',
  khu:       'images/deco/khu.png',
  phivat:   'images/deco/phivat.png',
  default:   'images/deco/default.png'
};


map.on('popupopen', function(ev) {
  try {
    const popup = ev.popup;
    const popupEl = popup.getElement(); // outer .leaflet-popup
    if (!popupEl) return;
    const wrapper = popupEl.querySelector('.leaflet-popup-content-wrapper');
    if (!wrapper) return;

    // try to identify category from marker (your markers store category)
    // prefer metadata on popup source
    let cat = null;
    if (popup._source && (popup._source.category || popup._source._meta && popup._source._meta.category)) {
      cat = popup._source.category || (popup._source._meta && popup._source._meta.category);
    }
    // fallback: if you included className 'popup-<cat>' when binding, parse it:
    if (!cat && popup.options && popup.options.className) {
      const m = popup.options.className.match(/popup-([^\s]+)/);
      if (m) cat = m[1];
    }
    cat = cat || 'default';

    // choose deco image and sizing (override per category if needed)
    const deco = (window.CATEGORY_DECOS && window.CATEGORY_DECOS[cat]) ? window.CATEGORY_DECOS[cat] : (window.CATEGORY_DECOS && window.CATEGORY_DECOS.default) || 'images/deco/kientruc.png';
    // optional per-category dimension customizations:
    let decoW = '56px', decoH = '56px', decoR = '-6deg';
    if (cat === 'dacbiet') { decoW = '72px'; decoH = '72px'; decoR = '-8deg'; }
    if (cat === 'kientruc') { decoW = '64px'; decoH = '64px'; decoR = '-10deg'; }
    // mobile values (fallback)
    let decoWMobile = '40px', decoHMobile = '40px', decoRMobile = '-4deg';

    // set CSS vars on the wrapper (these are read by CSS ::before)
    wrapper.style.setProperty('--popup-deco', `url('${deco}')`);
    wrapper.style.setProperty('--popup-deco-w', decoW);
    wrapper.style.setProperty('--popup-deco-h', decoH);
    wrapper.style.setProperty('--popup-deco-rotate', decoR);
    wrapper.style.setProperty('--popup-deco-w-mobile', decoWMobile);
    wrapper.style.setProperty('--popup-deco-h-mobile', decoHMobile);
    wrapper.style.setProperty('--popup-deco-rotate-mobile', decoRMobile);

    // Decide if the deco would be off-screen at the left edge -> flip to right
    const mapRect = document.getElementById('map').getBoundingClientRect();
    const popupRect = popupEl.getBoundingClientRect();
    const decoPx = parseInt(decoW.replace('px','')) || 56;
    // threshold: if popup's left edge is closer to map left than the deco width + margin -> flip
    const LEFT_THRESHOLD = decoPx + 8;
    if ((popupRect.left - mapRect.left) < LEFT_THRESHOLD) {
      wrapper.classList.add('deco-top-right');
    } else {
      wrapper.classList.remove('deco-top-right');
    }
  } catch (err) {
    console.warn('popup deco handler error', err);
  }
});

// cleanup on close to avoid leftover classes/styles
map.on('popupclose', function(ev) {
  try {
    const popupEl = ev.popup.getElement();
    if (!popupEl) return;
    const wrapper = popupEl.querySelector('.leaflet-popup-content-wrapper');
    if (!wrapper) return;
    wrapper.classList.remove('deco-top-right');
    // remove inline vars (optional)
    wrapper.style.removeProperty('--popup-deco');
    wrapper.style.removeProperty('--popup-deco-w');
    wrapper.style.removeProperty('--popup-deco-h');
    wrapper.style.removeProperty('--popup-deco-rotate');
    wrapper.style.removeProperty('--popup-deco-w-mobile');
    wrapper.style.removeProperty('--popup-deco-h-mobile');
    wrapper.style.removeProperty('--popup-deco-rotate-mobile');
  } catch(e) {}
});


  // --- Filter ---
  let activeFilter = "all";
  function applyFilter(category) {
    activeFilter = category;
    markerCluster.clearLayers();
    markerObjects.forEach(m => {
      if (activeFilter === "all" || m.category === activeFilter) {
        markerCluster.addLayer(m);
      }
    });
    searchInput.value = "";
    suggestions.style.display = "none";
  }

  // --- Search ---
  const searchInput = document.getElementById("search");
  const suggestions = document.getElementById("suggestions");

  function removeAccents(str) {
    return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
  }

  searchInput.addEventListener("input", () => {
    const query = removeAccents(searchInput.value.trim());
    suggestions.innerHTML = "";
    if (!query) {
      suggestions.style.display = "none";
      return;
    }
    const matches = markerObjects.filter(m =>
      (activeFilter === "all" || m.category === activeFilter) &&
      removeAccents(m.name).includes(query)
    );
    if (matches.length) {
      suggestions.style.display = "block";
      matches.forEach(m => {
        const li = document.createElement("li");
        const regex = new RegExp(`(${query})`, "gi");
        const highlightedName = m.name.replace(regex, "<strong>$1</strong>");
        li.innerHTML = highlightedName;
        li.addEventListener("click", () => {
          map.setView(m.getLatLng(), 16, { animate: true });
          m.openPopup();
          suggestions.style.display = "none";
        });
        suggestions.appendChild(li);
      });
    } else {
      suggestions.style.display = "none";
    }
  });

  document.addEventListener("click", (e) => {
    if (!document.querySelector(".search-bar").contains(e.target)) {
      suggestions.style.display = "none";
    }
  });

  // Fullscreen logic
const mapDiv = document.getElementById('map');
const fullscreenBtn = document.getElementById('fullscreen-btn');
fullscreenBtn.addEventListener('click', () => {
  if (!document.fullscreenElement && !mapDiv.classList.contains('fullscreen')) {
    if (mapDiv.requestFullscreen) {
      mapDiv.requestFullscreen();
    } else if (mapDiv.webkitRequestFullscreen) {
      mapDiv.webkitRequestFullscreen();
    } else if (mapDiv.msRequestFullscreen) {
      mapDiv.msRequestFullscreen();
    }
    mapDiv.classList.add('fullscreen');
    document.body.classList.add('fullscreen-active');
  } else {
    if (document.exitFullscreen) {
      document.exitFullscreen();
    } else if (document.webkitExitFullscreen) {
      document.webkitExitFullscreen();
    } else if (document.msExitFullscreen) {
      document.msExitFullscreen();
    }
    mapDiv.classList.remove('fullscreen');
    document.body.classList.remove('fullscreen-active');
  }
});
// Keep map size correct on fullscreen change
function handleFullscreenChange() {
  if (!document.fullscreenElement) {
    mapDiv.classList.remove('fullscreen');
    document.body.classList.remove('fullscreen-active');
  } else {
    mapDiv.classList.add('fullscreen');
    document.body.classList.add('fullscreen-active');
  }
  if (window.map && window.map.invalidateSize) {
    setTimeout(() => window.map.invalidateSize(), 300);
  }
}
document.addEventListener('fullscreenchange', handleFullscreenChange);
document.addEventListener('webkitfullscreenchange', handleFullscreenChange);
document.addEventListener('mozfullscreenchange', handleFullscreenChange);
document.addEventListener('MSFullscreenChange', handleFullscreenChange);
</script>
</div>
</div>
</div>

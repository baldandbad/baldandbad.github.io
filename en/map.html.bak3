// 2) update setActiveMarker (pulse)
function setActiveMarker(m) {
  if (activeMarker && activeMarker.getElement) {
    const prev = activeMarker.getElement();
    if (prev) {
      prev.querySelector('.marker-inner')?.classList.remove('pulse');
      prev.classList.remove('marker-active');
    }
  }
  activeMarker = m;
  if (!m) return;
  const el = m.getElement();
  if (!el) return;
  el.querySelector('.marker-inner')?.classList.add('pulse');
  el.classList.add('marker-active');
  if (m._icon) m._icon.style.zIndex = 9999;
}

// 3) cluster pop
markerCluster.on('clusterclick', function (e) {
  const cluster = e.layer;
  const childCount = cluster.getChildCount();
  const SPIDERFY_THRESHOLD = 12; // your existing threshold

  // cluster bounds and the highest zoom that'll show them separated
  const bounds = cluster.getBounds();
  // map.getBoundsZoom(bounds, paddingFalse) computes the zoom to show bounds exactly
  const bestZoom = Math.min(map.getMaxZoom(), map.getBoundsZoom(bounds, false));

  // If cluster is small, spiderfy in place
  if (childCount <= SPIDERFY_THRESHOLD) {
    try {
      // cluster.spiderfy() works in most plugin versions; fallback included
      if (typeof cluster.spiderfy === 'function') cluster.spiderfy();
      else if (typeof markerCluster.spiderfy === 'function') markerCluster.spiderfy(cluster);
      else console.warn('No spiderfy method found');
    } catch (err) {
      console.warn('spiderfy failed', err);
    }
    return;
  }

  // For larger clusters, attempt to zoom to a level that will break the cluster.
  // If already at or above bestZoom, spiderfy as a fallback.
  if (map.getZoom() >= bestZoom) {
    try {
      if (typeof cluster.spiderfy === 'function') cluster.spiderfy();
      else if (typeof markerCluster.spiderfy === 'function') markerCluster.spiderfy(cluster);
    } catch (err) {
      console.warn('spiderfy fallback failed', err);
    }
  } else {
    // Fit bounds but force the map to not exceed bestZoom.
    // We use moveend once to attempt spiderfy if still clustered after zoom.
    map.once('moveend', () => {
      // small timeout lets MarkerCluster recalc after zoom animation
      setTimeout(() => {
        // if cluster still exists at same position, spiderfy it
        try {
          if (typeof cluster.spiderfy === 'function') cluster.spiderfy();
        } catch (err) { /* ignore */ }
      }, 80);
    });

    // use fitBounds with maxZoom so we don't overshoot if map max zoom smaller
    try {
      map.fitBounds(bounds, { padding: [40, 40], maxZoom: bestZoom });
    } catch (err) {
      // fallback
      map.fitBounds(bounds, { padding: [40, 40] });
    }
  }
});

// 4) smooth fly for search suggestions (replace the previous setView)
function gotoMarker(m) {
  map.flyTo(m.getLatLng(), 16, { animate: true, duration: 1.0, easeLinearity: 0.25 });
  m.openPopup();
  setActiveMarker(m);
}

/* ---------------- Inverted dimmer (mask outside polygon) ---------------- */
/* Paste/replace previous dimmer code with this block.
   IMPORTANT: call addOrUpdateDimmerFromLayer(boundaryLayer) after you add boundaryLayer to the map. */

if (!map.getPane('dimmerPane')) {
  map.createPane('dimmerPane');
  const pane = map.getPane('dimmerPane');
  // z-index chosen so dimmer sits above tiles but below markers/popups
  pane.style.zIndex = 450;
  // Make the pane non-interactive so clicks go to markers above/below
  pane.style.pointerEvents = 'none';
}

let dimLayer = null;

/** Utility: wrap longitude into [-180,180] */
function wrapLng(lng) {
  return ((lng + 180) % 360 + 360) % 360 - 180;
}

/** Convert a Leaflet latlngs structure (possibly nested for MultiPolygon) into rings
 *  returns array of rings where each ring = [[lat, lng], ...]
 */
function extractRingsFromLatLngs(latlngs) {
  const rings = [];
  function walk(arr) {
    if (!arr || !arr.length) return;
    // detect array of LatLng points
    if (arr[0] && typeof arr[0].lat === 'number') {
      rings.push(arr.map(ll => [ll.lat, wrapLng(ll.lng)]));
    } else {
      // nested arrays (MultiPolygon or polygon with holes)
      arr.forEach(walk);
    }
  }
  walk(latlngs);
  return rings;
}

/** Convert GeoJSON Feature to rings (supports Polygon & MultiPolygon) */
function geoJsonFeatureToRings(feature) {
  if (!feature || !feature.geometry) return [];
  const geom = feature.geometry;
  const coords = (geom.type === 'Polygon') ? [geom.coordinates]
               : (geom.type === 'MultiPolygon') ? geom.coordinates
               : null;
  if (!coords) return [];
  const rings = [];
  coords.forEach(polygon => {
    polygon.forEach(ring => {
      // GeoJSON coords are [lng,lat] -> convert to [lat,lng] and wrap lon
      rings.push(ring.map(pt => [pt[1], wrapLng(pt[0])]));
    });
  });
  return rings;
}

/** Create the inverted dimmer polygon from an array of rings (holes).
 *  rings: [ [lat,lng,...], [lat,lng,...], ... ] (holes)
 */
function createDimmerFromRings(rings, options = {}) {
  // remove existing dimLayer
  if (dimLayer) { try { map.removeLayer(dimLayer); } catch (e) {} dimLayer = null; }

  if (!rings || !rings.length) {
    console.warn('createDimmerFromRings: no rings supplied.');
    return;
  }

  // big outer rectangle that covers world (lat, lng)
  const outer = [
    [  90, -180 ],
    [  90,  180 ],
    [ -90,  180 ],
    [ -90, -180 ]
  ];

  // Leaflet accepts an array where first element is outer ring, subsequent are holes
  const polygonWithHoles = [ outer ].concat(rings);

  dimLayer = L.polygon(polygonWithHoles, {
    pane: 'dimmerPane',
    color: options.color || '#000',
    weight: 0,
    opacity: 0,
    fillColor: options.fillColor || 'rgba(0,0,0,0.65)',
    fillOpacity: typeof options.fillOpacity === 'number' ? options.fillOpacity : 0.45,
    interactive: false
  }).addTo(map);

  // make sure marker cluster and boundary (if present) are above the dimmer
  // marker cluster typically lives in markerPane (~600 z-index)
  if (window.markerCluster && typeof window.markerCluster.bringToFront === 'function') {
    try { window.markerCluster.bringToFront(); } catch(e) {}
  }
}

/** High-level helper: accept a Leaflet layer (GeoJSON group, FeatureGroup, or Polygon)
 *  and create the inverted dimmer based on its geometry.
 */
function addOrUpdateDimmerFromLayer(layer) {
  if (!layer) { console.warn('addOrUpdateDimmerFromLayer: layer missing'); return; }

  // collect rings from layer(s)
  const rings = [];

  // if layer is a featureGroup or geojson group, iterate children
  if (layer instanceof L.FeatureGroup || layer instanceof L.LayerGroup) {
    layer.eachLayer(function(child) {
      if (typeof child.getLatLngs === 'function') {
        const r = extractRingsFromLatLngs(child.getLatLngs());
        r.forEach(rr => rings.push(rr));
      } else if (child.feature) {
        const r = geoJsonFeatureToRings(child.feature);
        r.forEach(rr => rings.push(rr));
      }
    });
  } else {
    // single layer or L.GeoJSON returned layer
    if (typeof layer.getLatLngs === 'function') {
      extractRingsFromLatLngs(layer.getLatLngs()).forEach(rr => rings.push(rr));
    } else if (layer.feature) {
      geoJsonFeatureToRings(layer.feature).forEach(rr => rings.push(rr));
    } else if (layer.options && layer.options.geometry) {
      // defensive: sometimes geojson style
      geoJsonFeatureToRings(layer.options.geometry).forEach(rr => rings.push(rr));
    }
  }

  if (!rings.length) {
    console.warn('addOrUpdateDimmerFromLayer: found no rings on the provided layer.');
    return;
  }

  createDimmerFromRings(rings);

  // expose convenient function to update later if needed
  window.updateMapDimmer = () => addOrUpdateDimmerFromLayer(layer);
}

/* Export small API for debugging */
window.__dimmer = {
  addOrUpdateDimmerFromLayer,
  createDimmerFromRings,
  removeDimmer: () => { if (dimLayer) { try { map.removeLayer(dimLayer); } catch(e){} dimLayer = null; } }
};

/* Example usage:
   After you add the boundary layer (boundaryLayer = L.geoJSON(...).addTo(map);)
   call:
     addOrUpdateDimmerFromLayer(boundaryLayer);
   If you update the geometry later, call:
     window.updateMapDimmer();
*/

/* ---------------- End Dimmer block ---------------- */


/** Fetch geojson and wire up map layers robustly */
/* --- Fetch boundary and wire dimmer (REPLACE your current fetch block with this) --- */
fetch('js/hcmc-boundary.geojson')
  .then(r => {
    if (!r.ok) throw new Error('Network response was not ok');
    return r.json();
  })
  .then(geojson => {
    // Add a visible boundary (optional)
    try {
      boundaryLayer = L.geoJSON(geojson, {
        style: { color: "#ff5733", weight: 3, fill: false }
      }).addTo(map);
    } catch (e) {
      console.warn('Failed to add boundaryLayer for visibility', e);
    }

    // Use the layer to create inverted dimmer (this helper extracts rings for you)
    try {
      addOrUpdateDimmerFromLayer(boundaryLayer);
      console.log('Dimmer created from boundaryLayer.');
    } catch (err) {
      console.warn('Failed to create dimmer from boundaryLayer', err);
    }

    // Optional: fade-in the dimmer
    if (typeof dimLayer !== 'undefined' && dimLayer) {
      dimLayer.setStyle({ fillOpacity: 0 });
      let step = 0, steps = 10, target = 0.45;
      const tick = () => {
        step++;
        dimLayer.setStyle({ fillOpacity: +(target * (step / steps)).toFixed(3) });
        if (step < steps) setTimeout(tick, 35);
      };
      setTimeout(tick, 120);
    }
  })
  .catch(err => {
    console.error('Failed to load/parse boundary geojson for dimmer:', err);
  });
  


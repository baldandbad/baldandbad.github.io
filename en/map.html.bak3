<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster/dist/leaflet.markercluster.js"></script>
<script>
  // basic escaping for popup injection safety
function escapeHtml(str){ return (str||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
// build category-colored icons from a single external SVG file
const CATEGORY_COLORS = {
  thanhpho: '#ff7043',
  quocgia:  '#d32f2f',
  kientruc: '#2196f3',
  baotang:  '#f59e0b',
  khaoco:   '#10b981',
  dacbiet:  '#8b5cf6',
  cachmang: '#ef4444',
  khu:      '#FFFF00',
  phivat:  '#9c27b0',
  default:  '#6b7280'
};
/* ---------- Automatic SVG tinting (no SVG edits required) ---------- */

const _svgTemplateCache = {};
const _tintedIconCache = {};

// fetch SVG text (with optional fallbackText if fetch fails e.g. file://)
async function fetchSvgText(url, fallbackText = null) {
  if (_svgTemplateCache[url]) return _svgTemplateCache[url];
  try {
    const res = await fetch(url, { cache: 'no-store' });
    if (!res.ok) throw new Error('fetch failed: ' + res.status);
    const txt = await res.text();
    _svgTemplateCache[url] = txt;
    return txt;
  } catch (err) {
    if (fallbackText) {
      console.warn('Using fallback SVG text for', url, err);
      _svgTemplateCache[url] = fallbackText;
      return fallbackText;
    }
    console.error('Failed to fetch SVG:', err);
    throw err;
  }
}

// Replace fills/strokes/styles with color. Conservative: skip fill="none" and stroke="none"
function tintSvgString(svgText, color) {
  if (!svgText) return svgText;
  let s = svgText;
  // remove <style> blocks (they may override inline attributes)
  s = s.replace(/<style[\s\S]*?<\/style>/gi, '');
  // If the SVG contains a placeholder token CURRENT_COLOR, replace that first
  if (s.indexOf('CURRENT_COLOR') !== -1) {
    s = s.replace(/CURRENT_COLOR/g, color);
  }
  // Replace fill="..." except fill="none"
  s = s.replace(/fill="(?!none)([^"]*)"/gi, `fill="${color}"`);
  // Replace stroke="..." except stroke="none"
  s = s.replace(/stroke="(?!none)([^"]*)"/gi, `stroke="${color}"`);
  // Replace style="...fill:...;..." and style stroke occurrences
  s = s.replace(/style="([^"]*)"/gi, (m, styleContent) => {
    let ns = styleContent;
    if (/fill\s*:\s*[^;]+/i.test(ns)) ns = ns.replace(/fill\s*:\s*[^;]+/gi, `fill:${color}`);
    if (/stroke\s*:\s*[^;]+/i.test(ns)) ns = ns.replace(/stroke\s*:\s*[^;]+/gi, `stroke:${color}`);
    return `style="${ns}"`;
  });
  return s;
}

// Produce a compact data: URL
function svgToDataUrl(svgText) {
  const cleaned = svgText.replace(/\r?\n|\s{2,}/g, ' ').trim();
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(cleaned);
}

// Main helper: return an L.icon tinted to `color` and sized to `size`
function getTintedIcon(color = '#ff0000', size = 38) {
  const svg = `
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="${size}" height="${size}">
    <!-- Outer pin path (tinted dynamically) -->
    <path d="M16 0C10.48 0 6 4.48 6 10c0 7.5 10 22 10 22s10-14.5 10-22c0-5.52-4.48-10-10-10z"
      fill="${color}" stroke="white" stroke-width="0.6"/>
      
    <!-- Inner circle (always white) -->
    <circle cx="16" cy="10" r="3.5" fill="white" opacity="0.9"/>
  </svg>`;

  const url = `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;

  return L.icon({
    iconUrl: url,
    iconSize: [size, size],
    iconAnchor: [size / 2, size],
    popupAnchor: [0, -size * 0.9]
  });
}

const LEGEND_LABELS = {
  thanhpho: 'Di tích cấp thành phố',
  quocgia:  'Di tích cấp quốc gia',
  kientruc: 'Kiến trúc - Nghệ thuật',
  baotang:  'Bảo tàng',
  khaoco:   'Di tích khảo cổ',
  dacbiet:  'Di tích quốc gia đặc biệt',
  cachmang: 'Di tích lịch sử – văn hóa cách mạng',
  khu:      'Khu dự trữ sinh quyển',
  phivat: 'Di sản văn hóa Phi vật thể',
  default:  'Khác'
};

// ---------- Tinted icons + popup-color injection (paste after CATEGORY_COLORS) ----------
const categoryIcons = {}; // L.icon per category

async function buildIconsFromExternalSvg(opts = {}) {
  const url = opts.url || 'images/map-pin.svg';
  const size = opts.size || 35;

  let svgText = null;
  // try fetch first
  try {
    const res = await fetch(url, { cache: 'no-store' });
    if (!res.ok) throw new Error('SVG fetch failed: ' + res.status);
    svgText = await res.text();
  } catch (fetchErr) {
    // fallback to inline content if provided (useful when running file://)
    if (typeof window.SVG_INLINE === 'string' && window.SVG_INLINE.trim().length) {
      svgText = window.SVG_INLINE;
      console.warn('Using SVG_INLINE fallback (no fetch).');
    } else {
      console.warn('Failed to fetch SVG and no SVG_INLINE provided:', fetchErr);
      // create plain icons that use the file directly (no tinting)
      Object.keys(CATEGORY_COLORS).forEach(cat => {
        categoryIcons[cat] = L.icon({
          iconUrl: url,
          iconSize: [size, size],
          iconAnchor: [size/2, size/2],
          popupAnchor: [0, -Math.round(size/2) - 6]
        });
      });
      return;
    }
  }

  // remove any <style> blocks so inline fill replacements are effective
  svgText = svgText.replace(/<style[\s\S]*?<\/style>/gi, '');

  function tintSvg(svgStr, color) {
    let s = svgStr;
    // Replace fill="..." but skip fill="none"
    s = s.replace(/fill="(?!none)([^"]*)"/gi, `fill="${color}"`);
    // Replace stroke="..."
    s = s.replace(/stroke="(?!none)([^"]*)"/gi, `stroke="${color}"`);
    // Replace style="...fill:...;..." patterns
    s = s.replace(/style="([^"]*)"/gi, (m, styleContent) => {
      let ns = styleContent;
      if (/fill\s*:\s*[^;]+/i.test(ns)) ns = ns.replace(/fill\s*:\s*[^;]+/gi, `fill:${color}`);
      if (/stroke\s*:\s*[^;]+/i.test(ns)) ns = ns.replace(/stroke\s*:\s*[^;]+/gi, `stroke:${color}`);
      return `style="${ns}"`;
    });
    return s;
  }

  Object.keys(CATEGORY_COLORS).forEach(cat => {
    try {
      const color = CATEGORY_COLORS[cat] || CATEGORY_COLORS.default;
      const tinted = tintSvg(svgText, color);
      const dataUrl = 'data:image/svg+xml;utf8,' + encodeURIComponent(tinted);
      categoryIcons[cat] = L.icon({
        iconUrl: dataUrl,
        iconSize: [size, size],
        iconAnchor: [size/2, size/2],
        popupAnchor: [0, -Math.round(size/2) - 6],
        className: ''
      });
    } catch (err) {
      console.warn('Failed to tint for', cat, err);
      categoryIcons[cat] = L.icon({
        iconUrl: url,
        iconSize: [size, size],
        iconAnchor: [size/2, size/2],
        popupAnchor: [0, -Math.round(size/2) - 6]
      });
    }
  });

  if (!categoryIcons.default) categoryIcons.default = categoryIcons[Object.keys(categoryIcons)[0]];
}

// helper: lighten a hex color by percent (0-100)
function lightenHex(hex, percent) {
  // normalize hex (#abc -> #aabbcc)
  let h = hex.replace('#','');
  if (h.length === 3) h = h.split('').map(ch => ch+ch).join('');
  const num = parseInt(h, 16);
  let r = (num >> 16) & 0xFF;
  let g = (num >> 8) & 0xFF;
  let b = num & 0xFF;
  const mix = (v) => Math.round(v + (255 - v) * (percent/100));
  r = mix(r); g = mix(g); b = mix(b);
  return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
}

// robust popup CSS injector — paste after CATEGORY_COLORS and before marker creation
function injectPopupCategoryCSS_Robust() {
  const ID = 'popup-cat-styles-robust';
  const old = document.getElementById(ID);
  if (old) old.remove();

  const style = document.createElement('style');
  style.id = ID;

  let css = `
    /* general popup improvements */
    .leaflet-popup-content-wrapper { border-radius: 12px !important; box-shadow: 0 12px 40px rgba(0,0,0,0.10) !important; }
    .leaflet-popup-tip { filter: drop-shadow(0 6px 18px rgba(0,0,0,0.06)); }
    /* ensure popup inner content uses our popup-content block if present */
    .leaflet-popup-content-wrapper .popup-content { padding: 12px 14px; box-sizing: border-box; }
    .popup-content .popup-thumb { width:100%; height:160px; object-fit:cover; border-radius:8px; display:block; margin-bottom:12px; }
    .popup-actions-inline { display:flex; gap:12px; flex-wrap:nowrap; align-items:center; margin-top:12px; }
    @media (max-width:420px) { .popup-actions-inline { flex-wrap:wrap; gap:8px; } }

    .popup-btn { color:#fff; border:none; cursor:pointer; border-radius:22px; padding:10px 16px; font-weight:700; white-space:nowrap; box-shadow:0 10px 30px rgba(0,0,0,0.12); transition: transform .12s, box-shadow .12s; }
    .popup-btn:active{ transform: translateY(1px) scale(.995); }
    .popup-btn:hover { box-shadow:0 14px 40px rgba(0,0,0,0.14); }
  `;

  // add per-category rules (set full border & tip color & CSS vars)
  Object.keys(CATEGORY_COLORS).forEach(cat => {
    const c = CATEGORY_COLORS[cat] || CATEGORY_COLORS.default;
    // produce a slightly lighter color for gradient
    function lighten(hex, pct){ 
      let h = hex.replace('#',''); if (h.length===3) h = h.split('').map(x=>x+x).join('');
      const n = parseInt(h,16); let r=(n>>16)&255, g=(n>>8)&255, b=n&255;
      const mix=(v)=>Math.round(v + (255-v)*(pct/100));
      r=mix(r); g=mix(g); b=mix(b);
      return '#'+((1<<24)+(r<<16)+(g<<8)+b).toString(16).slice(1);
    }
    const light = lighten(c, 28);

    css += `
      /* apply explicit border (overrides any generic border rules) */
      .leaflet-popup-content-wrapper.popup-${cat}, .leaflet-popup.popup-${cat} .leaflet-popup-content-wrapper {
        border: 3px solid ${c} !important;
        --cat: ${c};
        --cat-light: ${light};
      }

      /* tip color regardless of where class was attached */
      .leaflet-popup-content-wrapper.popup-${cat} + .leaflet-popup-tip,
      .leaflet-popup.popup-${cat} .leaflet-popup-tip,
      .leaflet-popup-tip.popup-${cat} {
        border-top-color: ${c} !important;
      }

      /* ensure popup-buttons use these variables */
      .leaflet-popup-content-wrapper.popup-${cat} .popup-btn,
      .leaflet-popup.popup-${cat} .leaflet-popup-content-wrapper .popup-btn {
        background: linear-gradient(90deg, var(--cat-light), var(--cat)) !important;
      }
    `;
  });

  style.appendChild(document.createTextNode(css));
  document.head.appendChild(style);
}


// Call this before creating markers:
(async function prepareIconsAndLegend() {
  await buildIconsFromExternalSvg({ url: 'images/map-pin.svg', size: 40
   });
  // you can now create markers using categoryIcons[cat]
  // If you already create markers elsewhere, ensure that code runs after this completes.
})();



// to highlight a selected marker
function setActiveMarker(m) {
  if (activeMarker && activeMarker.getElement) {
    const prev = activeMarker.getElement();
    if (prev) prev.classList.remove('marker-active');
  }
  activeMarker = m;
  if (!m) return;
  const el = m.getElement();
  if (el) el.classList.add('marker-active');
  // bring to front so it's visible above cluster/others
  if (m._icon) m._icon.style.zIndex = 9999;
}



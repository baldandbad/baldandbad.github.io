  const filterBtn = document.getElementById("filter-btn");
  const filterPanel = document.getElementById("filter-panel");
  filterBtn.addEventListener("click", () => {
    filterPanel.classList.toggle("active");
  });

  const map = L.map('map', {
    minZoom: 7,
    maxZoom: 16,
    zoomControl: false
  }).setView([10.7769, 106.7009], 10);
  L.control.zoom({ position: 'bottomleft'
  }).addTo(map);
  L.tileLayer('https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);

  const markerCluster = L.markerClusterGroup({
  showCoverageOnHover: false,
  spiderfyOnEveryZoom: false,
  spiderfyOnMaxZoom: true,    // spiderfy automatically if you click at max zoom
  zoomToBoundsOnClick: false, // we'll handle zoom+spiderfy logic manually
  animate: true,
  // keep your iconCreateFunction here (unchanged)
  iconCreateFunction: function(cluster) {
    const childCount = cluster.getChildCount();
    let sizeClass = 'large';
    if (childCount < 10) sizeClass = 'small';
    else if (childCount < 40) sizeClass = 'medium';
    const color = childCount < 10 ? '#47c0a6' : childCount < 40 ? '#f59e0b' : '#ef4444';
    const html = `<div class="marker-cluster-custom ${sizeClass}" style="background:${color}"><span>${childCount}</span></div>`;
    const size = sizeClass === 'small' ? 20 : sizeClass === 'medium' ? 24 : 28;
    return L.divIcon({ html, className: 'marker-cluster-wrapper', iconSize: L.point(size, size) });
  }
});
map.addLayer(markerCluster);

    transition: background .16s, color .16s;
    font-size: 0.98rem;
    position: relative;
  }
  .custom-navbar-dropdown a:hover {
    background: #fff3f1;
    color: #d32f2f;
  }
  .custom-navbar-dropdown a::before {
    content: '\2022';
    color: #ff7043;
    font-size: 1.2em;
    margin-right: 8px;
    opacity: 0.7;
  }
  .custom-navbar-toggle {
    display: none;
    background: none;
    border: none;
    color: #e53935;
    font-size: 2rem;
    cursor: pointer;
    margin-left: 12px;
    border-radius: 8px;
    padding: 4px 10px;
    transition: background .18s;
  }
  .custom-navbar-toggle:hover {
    background: #ffe3de;
  }
  @media (max-width: 900px) {
    .custom-navbar-inner {
      flex-wrap: wrap;
      height: auto;
      padding: 0 10px;
    }
    .custom-navbar-nav {
      flex-direction: column;

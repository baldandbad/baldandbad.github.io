      padding: 16px 22px 14px 22px;
    }
    .custom-navbar-link::after {
      left: 22px;
      right: 22px;
      bottom: 4px;
    }
    .custom-navbar-link:hover {
      background: #fff3f1;
      color: #d32f2f;
    }
    .custom-navbar-dropdown {
      position: static;
      box-shadow: none;
      background: #fff;
      border-radius: 0;
      min-width: 100%;
      padding: 0;
      border: none;
    }
    .custom-navbar-dropdown a {
      padding: 13px 32px;
    }
    .custom-navbar-toggle {
      display: block;
    }
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

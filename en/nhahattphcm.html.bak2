<script>
                  window.POST_ID = 26;
                  const API_URL1 = "https://baldandbadgithubio-production-4f3f.up.railway.app/comments";
                  async function loadComments() {
                    const res = await fetch(`${API_URL1}?post_id=${window.POST_ID}`); // API endpoint from your backend
                    const comments = await res.json();
                    const list = document.getElementById("comment-list");
                    list.innerHTML = ""; // clear old comments
                    comments.forEach(c => {
                      const html = `
      
																				<li class="comment">
																					<article class="comment-body">
																						<div class="author-photo">
																							<a href="blog-details.html" class="avatar">
																								<img class="avatar" src="${c.avatar || 'images/use_img/post_author.jpg'}" alt="" />
																							</a>
																						</div>
																						<div class="comment-wrapper">
																							<div class="comment-meta">
																								<div class="comment-author vcard">
																									<h5 class="fn">${c.name}</h5>
																								</div>
																							</div>
																							<div class="comment-content">
																								<p>${c.message}</p>
																							</div>
																							<div class="comment-metadata">
																								<span>${new Date(c.created_at).toLocaleDateString()}</span>
																							</div>
																							<div class="reply">
																								<a href="#" class="comment-reply-link btn btn-default">Reply</a>
																							</div>
																						</div>
																					</article>
																				</li>
    `;
                      list.insertAdjacentHTML("beforeend", html);
                    });
                  }
                  // Call on page load
                  loadComments();
                </script>
<div class="comment-respond" id="respond">
<h3 class="comment-reply-title" id="reply-title">Bình Luận</h3>
<form action="#" class="comment-form" id="commentform" method="post">
<p class="comment-form-author">
<label>Tên <span class="required">*</span>
</label>
<input id="author" name="author" required="" type="text"/>
</p>
<p class="comment-form-comment">
<label>Bình luận</label>
<textarea cols="45" id="comment" name="comment" required="" rows="8"></textarea>
</p>
<p class="form-submit">
<input class="submit btn btn-default" id="submit" type="submit" value="Submit"/>
</p>
</form>
</div>
<script>
                  window.POST_ID = 26;
                  const postID = window.POST_ID;
                  const API_URL = "https://baldandbadgithubio-production-4f3f.up.railway.app/comments";

                  function buildCommentTree(comments) {
                    const map = {};
                    const roots = [];
                    comments.forEach(c => {
                      c.replies = [];
                      map[c.id] = c;
                    });
                    comments.forEach(c => {
                      if (c.parent_id) {
                        map[c.parent_id]?.replies.push(c);
                      } else {
                        roots.push(c);
                      }
                    });
                    return roots;
                  }

                  function createCommentHTML(c, depth = 0) {
                    // Calculate indentation - limit to 5 levels max for sanity
                    const indent = Math.min(depth, 5) * 30; // 30px per level
                    return `
    
																						<li class="comment ${depth > 0 ? 'is-reply' : ''}" 
        id="li-comment-${c.id}"
        style="margin-left: ${indent}px">
																							<article class="comment-body">
																								<div class="author-photo">
																									<a href="blog-details.html" class="avatar">
																										<img class="avatar" src="${c.avatar || 'images/use_img/post_author.jpg'}" alt="" />
																									</a>
																								</div>
																								<div class="comment-wrapper">
																									<div class="comment-meta">
																										<div class="comment-author vcard">
																											<h5 class="fn">${c.name}</h5>
              ${depth > 0 ? `
																											<span class="reply-indicator">↳ replied </span>` : ''}
            
																										</div>
																									</div>
																									<div class="comment-content">
																										<p>${c.message}</p>
																									</div>
																									<div class="comment-metadata">
																										<span>${new Date(c.created_at).toLocaleDateString()}</span>
																									</div>
																									<div class="reply">
																										<a href="#" class="comment-reply-link btn btn-default">Reply</a>
																									</div>
																								</div>
																							</article>
      ${c.replies?.length ? `
        
																							<ol class="comment-replies">
          ${c.replies.map(reply => createCommentHTML(reply, depth + 1)).join('')}
        </ol>
      ` : ''}
    
																						</li>
  `;
                  }
                  // Load comments from backend
                  async function loadComments() {
                    const res = await fetch(`${API_URL}?post_id=${window.POST_ID}`);
                    const comments = await res.json();
                    const nestedComments = buildCommentTree(comments);
                    const list = document.getElementById("comment-list");
                    list.innerHTML = "";
                    nestedComments.forEach(c => {
                      list.insertAdjacentHTML("beforeend", createCommentHTML(c));
                    });
                  }
                  document.addEventListener("click", function(e) {
                    if (e.target.classList.contains("comment-reply-link")) {
                      e.preventDefault();
                      // Remove any existing inline reply forms
                      document.querySelectorAll(".inline-reply-form").forEach(f => f.remove());
                      const commentElement = e.target.closest(".comment");
                      const parentId = commentElement.id.replace("li-comment-", "");
                      // Create a small inline reply form
                      const replyForm = document.createElement("form");
                      replyForm.classList.add("inline-reply-form");
                      replyForm.innerHTML = `
      
																						<input type="text" name="reply-name" placeholder="Your name" required />
																						<textarea name="reply-message" placeholder="Write your reply..." required></textarea>
																						<button type="submit">Post Reply</button>
    `;
                      // Append form to comment
                      commentElement.appendChild(replyForm);
                      // Handle reply form submission
                      replyForm.addEventListener("submit", async function(e) {
                        e.preventDefault();
                        const name = this.querySelector("input[name='reply-name']").value;
                        const message = this.querySelector("textarea[name='reply-message']").value;
                        console.log(name);
                        console.log(message);
                        const created_at = new Date();
                        await fetch("https://baldandbadgithubio-production-4f3f.up.railway.app/comments", {
                          method: "POST",
                          headers: {
                            "Content-Type": "application/json"
                          },
                          body: JSON.stringify({
                            name,
                            message,
                            avatar: null,
                            created_at: created_at,
                            post_id: postID,
                            parent_id: parentId
                          })
                        });
                        // Reload comments
                        loadComments();
                      });
                    }
                  });
                  // Handle form submit
                  document.getElementById("commentform").addEventListener("submit", async function(e) {
                    e.preventDefault();
                    const name = document.getElementById("author").value;
                    const message = document.getElementById("comment").value;
                    const created_at = new Date();
                    const post_id = postID;
                    await fetch(API_URL, {
                      method: "POST",
                      headers: {
                        "Content-Type": "application/json"
                      },
                      body: JSON.stringify({
                        name,
                        message,
                        avatar: null,
                        created_at,
                        post_id,
                        parent_id: null
                      })
                    });
                    this.reset();
                    loadComments();
                  });
                  // Load on page start
                  loadComments();
                </script>
</div>

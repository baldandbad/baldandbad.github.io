  .custom-navbar-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px 8px 18px;
    color: #2f2f2f;
    font-weight: 600;
    border-radius: 8px 8px 0 0;
    background: none;
    border: none;
    font-size: 1rem;
    position: relative;
    transition: color .18s, background .18s;
  }
  .custom-navbar-link::after {
    content: '';
    display: block;
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 2px;
    height: 2.5px;
    background: linear-gradient(90deg, #e53935 0%, #ff7043 100%);
    border-radius: 2px;
    transform: scaleX(0);
    transition: transform .22s;
  }
  .custom-navbar-link:hover, .custom-navbar-link:focus {
    color: #e53935;
    background: #f9f9f9;
  }
  .custom-navbar-link:hover::after, .custom-navbar-link:focus::after {
    transform: scaleX(1);
  }
  .custom-navbar-dropdown {
    display: none;
    position: absolute;
    left: 0;
    top: 110%;
    min-width: 200px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(44,62,80,0.13);
    padding: 8px 0;
    z-index: 1001;
    border: 1.5px solid #f3f3f3;
    animation: fadeIn .18s;
  }
  .custom-navbar-nav > li:hover > .custom-navbar-dropdown,
  .custom-navbar-nav > li:focus-within > .custom-navbar-dropdown {
    display: block;
  }
  .custom-navbar-dropdown a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 28px 11px 22px;
    color: #e53935;
    font-weight: 500;
    text-decoration: none;
